# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=chatbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# OpenAI API Key (https://platform.openai.com/api-keys) -- starts with "sk-"
OPENAI_API_KEY=your_openai_api_key_here

# Model used to write the answers. Validated when the server starts.
OPENAI_MODEL=gpt-4.1-mini
